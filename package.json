{
  "name": "rentnerd-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n client,server,worker \"vite\" \"tsx watch --env-file-if-exists=.env.local src/server/main.ts\" \"tsx watch --env-file-if-exists=.env.local src/worker/main.ts\"",
    "build": "vite build && node scripts/build-server.mjs",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts --passWithNoTests",
    "test:integration": "vitest run --config vitest.int.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
