# Copy to .env.local for `npm run dev` (never commit real values; .env.local is git-ignored).
# Points at the services from `docker compose up -d --wait`.
NODE_ENV=development
PORT=8080
APP_URL=http://localhost:8080
ADMIN_EMAIL=admin@example.test
DATABASE_URL=postgres://rentnerd:rentnerd@localhost:5432/rentnerd
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio12345
AWS_ENDPOINT_URL_S3=http://localhost:9000
AWS_REGION=us-east-1
BUCKET_NAME=rentnerd-dev
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=RentNerd <noreply@mail.rentnerd.xyz>
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
TZ=UTC
